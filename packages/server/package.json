{
  "name": "@framebook/server",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/app/*",
    "#domains/*": "./src/domains/*",
    "#infra/*": "./src/infrastructure/*",
    "#testing/*": "./src/testing/*"
  },
  "scripts": {
    "dev": "node src/index.mjs",
    "start": "node src/index.mjs",
