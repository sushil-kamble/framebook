{
  "name": "framebook",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "framebook": "./bin/framebook.mjs"
  },
  "files": [
    "bin",
    "packages/server/src",
    "packages/server/package.json",
    "packages/shared/src",
    "packages/shared/package.json",
    "packages/client/dist",
    "packages/client/package.json",
    "README.md"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:client": "pnpm --filter @framebook/client dev",
    "dev:server": "pnpm --filter @framebook/server dev",
    "build": "pnpm --filter @framebook/shared build && pnpm --filter @framebook/client build",
    "preview": "pnpm --filter @framebook/client preview",
    "test": "pnpm --recursive --if-present run test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "start": "node bin/framebook.mjs",
    "check:ci": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "nitro",
      "sharp",
      "workerd"
    ]
  }
}
